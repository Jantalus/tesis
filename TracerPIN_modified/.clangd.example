# Generated by scripts/configure-clangd.sh.
# Replace @PIN_ROOT@ with the root of the Intel PIN 3.30 installation.
CompileFlags:
  Add:
    - -std=c++14
    - -DPIN_CRT=1
    - -D_LIBCPP_DISABLE_AVAILABILITY
    - -DTARGET_IA32E
    - -DHOST_IA32E
    - -DTARGET_LINUX
    - -fPIC
    - -faligned-new
    - -fno-exceptions
    - -fno-rtti
    - -fno-strict-aliasing
    - -Wno-unknown-pragmas
    - -I@PIN_ROOT@/source/include/pin
    - -I@PIN_ROOT@/source/include/pin/gen
    - -I@PIN_ROOT@/source/tools/Utils
    - -I@PIN_ROOT@/source/tools/InstLib
    - -isystem@PIN_ROOT@/extras/cxx/include
    - -isystem@PIN_ROOT@/extras/crt/include
    - -isystem@PIN_ROOT@/extras/crt/include/arch-x86_64
    - -isystem@PIN_ROOT@/extras/crt/include/kernel/uapi
    - -isystem@PIN_ROOT@/extras/crt/include/kernel/uapi/asm-x86
    - -isystem@PIN_ROOT@/extras/components/include
    - -isystem@PIN_ROOT@/extras/xed-intel64/include/xed
